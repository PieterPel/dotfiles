+// SetPaneOption sets the user option name on paneID, or unsets it when
+// value is empty. tmux's status line reads it: an agent's status for its
+// window and session, whatever is drawing the bar.
+func (c *Client) SetPaneOption(ctx context.Context, paneID, name, value string) error {
+	if value == "" {
+		_, err := c.run(ctx, "set-option", "-p", "-u", "-t", paneID, name)
+		return err
+	}
+	_, err := c.run(ctx, "set-option", "-p", "-t", paneID, name, value)
+	return err
+}
