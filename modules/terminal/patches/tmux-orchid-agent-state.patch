+// paneTagger writes onto a pane. Satisfied by tmux.Client.
+type paneTagger interface {
+	SetPaneOption(ctx context.Context, paneID, name, value string) error
+}
+
+// AgentStateOption is the pane option holding an agent's status, for the
+// tmux status line: idle, thinking, tool_use, error, done or unknown.
+const AgentStateOption = "@agent_state"
+
+// AgentSinceOption holds when that status began, in Unix seconds: what has
+// waited longest comes first, however much it redraws meanwhile.
+const AgentSinceOption = "@agent_since"
+
+// tagPanes keeps AgentStateOption and AgentSinceOption on each agent's pane
+// in step with what this poll saw: set when it appears or changes, unset
+// when it's gone.
+func tagPanes(ctx context.Context, t paneTagger, events []Event) {
+	now := strconv.FormatInt(time.Now().Unix(), 10)
+	for _, ev := range events {
+		if ev.PaneID == "" {
+			continue
+		}
+		state, since := string(ev.Agent.Status), now
+		if ev.Kind == EventAgentRemoved {
+			state, since = "", ""
+		}
+		for name, value := range map[string]string{AgentStateOption: state, AgentSinceOption: since} {
+			if err := t.SetPaneOption(ctx, ev.PaneID, name, value); err != nil {
+				slog.Debug("tagging pane", "pane", ev.PaneID, "option", name, "error", err)
+			}
+		}
+	}
+}
