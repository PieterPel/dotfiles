diff --git a/state/tag_test.go b/state/tag_test.go
new file mode 100644
index 0000000..7f36a09
--- /dev/null
+++ b/state/tag_test.go
@@ -0,0 +1,44 @@
+package state
+
+import (
+	"context"
+	"testing"
+
+	"github.com/FelipeAfonso/tmux-orchid/detector"
+)
+
+type fakeTagger struct{ set, since map[string]string }
+
+func (f *fakeTagger) SetPaneOption(_ context.Context, pane, name, value string) error {
+	if name == AgentSinceOption {
+		if value != "" {
+			f.since[pane] = value
+		} else {
+			delete(f.since, pane)
+		}
+		return nil
+	}
+	if value == "" {
+		delete(f.set, pane)
+	} else {
+		f.set[pane] = value
+	}
+	return nil
+}
+
+func TestTagPanesFollowsAgents(t *testing.T) {
+	f := &fakeTagger{set: map[string]string{"%3": "idle"}, since: map[string]string{"%3": "1"}}
+	tagPanes(context.Background(), f, []Event{
+		{Kind: EventAgentAdded, PaneID: "%1", Agent: detector.AgentInfo{Status: detector.StatusThinking}},
+		{Kind: EventAgentStatusChanged, PaneID: "%2", Agent: detector.AgentInfo{Status: detector.StatusIdle}},
+		{Kind: EventAgentRemoved, PaneID: "%3"},
+		{Kind: EventSnapshotUpdated},
+	})
+	want := map[string]string{"%1": "thinking", "%2": "idle"}
+	if len(f.set) != len(want) || f.set["%1"] != want["%1"] || f.set["%2"] != want["%2"] {
+		t.Fatalf("got %v, want %v", f.set, want)
+	}
+	if _, gone := f.since["%3"]; gone || f.since["%1"] == "" || f.since["%2"] == "" {
+		t.Fatalf("since: got %v", f.since)
+	}
+}
