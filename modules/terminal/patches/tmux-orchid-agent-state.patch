+package detector
+
+import "testing"
+
+func TestClaudeCode2Screens(t *testing.T) {
+	working := "  For forty-one years, an error in the bash script...\n" +
+		"────────\n❯\n────────\n  ⏵⏵ auto mode on (shift+tab to cycle) · esc to interrupt\n"
+	if got := DetectStatus(AgentClaudeCode, working); got != StatusThinking {
+		t.Fatalf("working screen: got %s", got)
+	}
+	idle := "  The error was in the bash script.\n✻ Cogitated for 1s\n────────\n❯\n────────\n  ⏵⏵ auto mode on (shift+tab to cycle)\n"
+	if got := DetectStatus(AgentClaudeCode, idle); got != StatusIdle {
+		t.Fatalf("idle screen: got %s", got)
+	}
+}
